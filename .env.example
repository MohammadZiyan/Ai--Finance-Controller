# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Mode 1: Embedded PGlite (Default)
# Leave DATABASE_URL blank or commented out. No PostgreSQL installation or Docker required.
# Data is automatically stored in ./data/pgdata.
DATABASE_URL=

# Mode 2: External PostgreSQL / Docker / Supabase / Neon
# Uncomment and provide your connection string below to connect to a standalone PostgreSQL database:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ==============================================================================
# OPTIONAL: EXTERNAL AI PROVIDER
# ==============================================================================
# OPENAI_API_KEY=

